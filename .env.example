# Zkopíruj do .env a vyplň. Klíče získáš zdarma na https://develop.battle.net
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Volitelné (uvedeny výchozí hodnoty)
BLIZZARD_REGION=eu
BLIZZARD_LOCALE=en_GB
# Jak dlouho se výsledek bere z disku bez nového dotazu (sekundy)
CACHE_TTL_SECONDS=900
# Doplňovat názvy itemů z Wowheadu, když je Blizzard nezná (0 = vypnout)
WOWSTATS_WOWHEAD=1
# Složka cache (výchozí: %LOCALAPPDATA%\wowstats, jinak ~/.cache/wowstats)
# WOWSTATS_CACHE_DIR=
